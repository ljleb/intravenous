{
    "name": "iv-client",
    "displayName": "Intravenous",
    "description": "Live graph inspection for Intravenous workspaces.",
    "version": "0.0.1",
    "publisher": "intravenous",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "workspaceContains:iv_project.jsonl",
        "onWebviewPanel:intravenous.graphEditor"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "build": "node ./esbuild.mjs",
        "watch": "node ./esbuild.mjs --watch",
        "typecheck": "tsc --noEmit -p ./tsconfig.json && vue-tsc --noEmit -p ./webview/tsconfig.json",
        "test": "tsc -p ./tsconfig.tests.json && node --test dist-test/test/**/*.test.js"
    },
    "dependencies": {
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.8.0"
    },
    "devDependencies": {
        "@types/node": "^22.15.31",
        "@types/vscode": "^1.85.0",
        "@vitejs/plugin-vue": "^5.2.4",
        "esbuild": "^0.25.5",
        "typescript": "^5.8.3",
        "vite": "^6.3.5",
        "vue": "^3.5.13",
        "vue-tsc": "^2.2.10"
    },
    "contributes": {
        "configuration": {
            "title": "Intravenous",
            "properties": {
                "intravenous.intravenousDir": {
                    "type": "string",
                    "default": "",
                    "description": "Absolute path to the directory that directly contains the intravenous executable. INTRAVENOUS_DIR takes precedence when set."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "intravenous",
                    "title": "Intravenous",
                    "icon": "media/intravenous.svg"
                }
            ]
        },
        "views": {
            "intravenous": [
                {
                    "id": "intravenous.liveGraph",
                    "name": "Intravenous",
                    "type": "webview"
                }
            ]
        },
        "commands": [
            { "command": "intravenous.undo", "title": "Intravenous: Undo Project Edit" },
            { "command": "intravenous.redo", "title": "Intravenous: Redo Project Edit" },
            {
                "command": "intravenous.openGraphEditor",
                "title": "Intravenous: Open Graph Editor"
            },
            {
                "command": "intravenous.addNode",
                "title": "Intravenous: Add Node"
            },
            {
                "command": "intravenous.editNode",
                "title": "Intravenous: Edit Node"
            },
            {
                "command": "intravenous.deleteNode",
                "title": "Intravenous: Delete Node"
            },
            {
                "command": "intravenous.openNodeSource",
                "title": "Intravenous: Open Node Source"
            },
            {
                "command": "intravenous.createPackage",
                "title": "Intravenous: New Package"
            },
            {
                "command": "intravenous.deleteConnection",
                "title": "Intravenous: Delete Connection"
            },
            {
                "command": "intravenous.saveProject",
                "title": "Intravenous: Save Project Now"
            },
            {
                "command": "intravenous.enableProjectAutosave",
                "title": "Intravenous: Enable Project Autosave"
            },
            {
                "command": "intravenous.disableProjectAutosave",
                "title": "Intravenous: Disable Project Autosave"
            }
        ]
    },
    "allowScripts": {
        "esbuild@0.25.12": true
    }
}
