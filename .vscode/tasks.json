{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Intravenous",
      "type": "shell",
      "command": "cmake --build build-release --target intravenous --parallel 16",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run Intravenous Development",
      "type": "process",
      "command": "nix",
      "args": ["develop", "--command", "./scripts/run_dev.sh", "${input:intravenousProject}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "intravenousProject",
      "type": "promptString",
      "description": "Intravenous project directory",
      "default": "projects/simple_sine"
    }
  ]
}
