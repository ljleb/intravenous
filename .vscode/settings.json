{
  "cmake.useVsDeveloperEnvironment": "always",
  "cmake.generator": "Ninja",
  "dagdocdiff.docsDir": "docs",
  "dagdocdiff.buildDir": "build-release",
  "files.watcherExclude": {
    "**/build/**": true,
    "**/build-release/**": true,
    "**/debug-release/**": true,
    "**/.direnv/**": true,
    "**/.intravenous-tooling/**": true,
    "**/node_modules/**": true,
    "**/vscode/client/dist/**": true,
    "**/vscode/client/dist-test/**": true,
    "**/vscode/client/dist-tools/**": true
  },
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build",
    "--query-driver=/nix/store/*/bin/clang,/nix/store/*/bin/clang++,C:/Program Files/Microsoft Visual Studio/*/*/VC/Tools/MSVC/**/bin/Hostx64/x64/cl.exe",
    "--log=verbose"
  ],
  "terminal.integrated.profiles.windows": {
    "MSVC Dev Shell": {
      "path": "C:\\Windows\\System32\\cmd.exe",
      "args": [
        "/k",
        "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "MSVC Dev Shell",
  "terminal.integrated.env.windows": {
    "IV_MODULE_SEARCH_PATH": "tests\\test_modules"
  }
}
