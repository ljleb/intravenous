+TEST_P(WaylandEventSourceTest, PointerButtonUsesAbsoluteLocationAfterUnlock) {
+  PostToServerAndWait([](wl::TestWaylandServerThread* server) {
+    wl_seat_send_capabilities(server->seat()->resource(),
+                             WL_SEAT_CAPABILITY_POINTER);
+  });
+  ASSERT_TRUE(connection_->seat()->pointer());
+
+  EXPECT_CALL(delegate_, DispatchEvent(_)).Times(1);
+  PostToServerAndWait([surface_id = window_->root_surface()->get_surface_id()](
+                          wl::TestWaylandServerThread* server) {
+    auto* surface = server->GetObject<wl::MockSurface>(surface_id)->resource();
+    auto* pointer = server->seat()->pointer()->resource();
+    wl_pointer_send_enter(pointer, server->GetNextSerial(), surface,
+                          wl_fixed_from_int(8), wl_fixed_from_int(16));
+    wl_pointer_send_frame(pointer);
+  });
+
+  auto* source = connection_->event_source();
+  const auto send_motion = [&](int x, int y) {
+    EXPECT_CALL(delegate_, DispatchEvent(_)).Times(1);
+    PostToServerAndWait([=](wl::TestWaylandServerThread* server) {
+      auto* pointer = server->seat()->pointer()->resource();
+      wl_pointer_send_motion(pointer, server->GetNextTime(),
+                             wl_fixed_from_int(x), wl_fixed_from_int(y));
+      wl_pointer_send_frame(pointer);
+    });
+  };
+  const auto send_click = [&](const gfx::PointF& expected) {
+    EXPECT_CALL(delegate_, DispatchEvent(_))
+        .Times(2)
+        .WillRepeatedly([&](Event* event) {
+          ASSERT_TRUE(event->IsMouseEvent());
+          EXPECT_EQ(event->AsMouseEvent()->location_f(), expected);
+        });
+    PostToServerAndWait([](wl::TestWaylandServerThread* server) {
+      auto* pointer = server->seat()->pointer()->resource();
+      for (auto state :
+           {WL_POINTER_BUTTON_STATE_PRESSED, WL_POINTER_BUTTON_STATE_RELEASED}) {
+        wl_pointer_send_button(pointer, server->GetNextSerial(),
+                               server->GetNextTime(), BTN_LEFT, state);
+        wl_pointer_send_frame(pointer);
+      }
+    });
+    testing::Mock::VerifyAndClearExpectations(&delegate_);
+  };
+  const auto move_relative = [&] {
+    EXPECT_CALL(delegate_, DispatchEvent(_)).Times(1);
+    source->OnRelativePointerMotion(gfx::Vector2dF(31, -5),
+                                    base::TimeTicks::Now());
+  };
+
+  source->SetRelativePointerMotionEnabled(true);
+  move_relative();
+  EXPECT_EQ(source->GetPointerLocation(), gfx::PointF(39, 11));
+  source->SetRelativePointerMotionEnabled(false);
+  send_click(gfx::PointF(8, 16));
+
+  source->SetRelativePointerMotionEnabled(true);
+  send_motion(27, 38);
+  move_relative();
+  source->SetRelativePointerMotionEnabled(false);
+  send_click(gfx::PointF(27, 38));
+
+  // The compositor can move the pointer after unlock. Such motion supersedes
+  // the saved location before the next click.
+  send_motion(42, 72);
+  send_click(gfx::PointF(42, 72));
+}
